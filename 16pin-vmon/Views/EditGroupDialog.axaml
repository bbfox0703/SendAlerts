<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:_16pin_vmon.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
        x:Class="_16pin_vmon.Views.EditGroupDialog"
        x:DataType="vm:EditGroupViewModel"
        Title="{Binding Title}"
        Width="500" Height="600"
        MinWidth="450" MinHeight="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:EditGroupViewModel />
    </Design.DataContext>

    <Border Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Basic Settings -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Group Settings" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Name}"
                                 Watermark="Unique group name"
                                 IsEnabled="{Binding CanChangeName}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Description}"
                                 Watermark="Optional description"
                                 Margin="0,8,0,0"/>

                        <CheckBox Grid.Row="2" Grid.Column="1"
                                  Content="Enabled"
                                  IsChecked="{Binding IsEnabled}"
                                  Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Message Template -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Message Template" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding MessageTemplate}"
                             Watermark="[Alert] {message}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"/>
                    <TextBlock Text="Variables: {message}, {timestamp}, {group_name}, {date}, {time}"
                               FontSize="10"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Actions Selection (TB2-3) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Actions" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AvailableActions.Count, StringFormat='({0} available)'}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Padding="8,4"/>
                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Padding="8,4"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding AvailableActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}"
                                              IsChecked="{Binding IsSelected}"
                                              Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Error Message -->
            <Border Grid.Row="3"
                    Background="#C62828"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="White"
                           FontSize="12"/>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Content="OK"
                        Command="{Binding ConfirmCommand}"
                        Width="80"
                        Classes="accent"/>
            </Grid>

        </Grid>
    </Border>
</Window>
