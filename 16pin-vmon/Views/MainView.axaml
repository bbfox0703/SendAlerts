<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:_16pin_vmon.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:conv="clr-namespace:_16pin_vmon.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="_16pin_vmon.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Resources>
	  <conv:AlertColorConverter x:Key="AlertColorConverter" />
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Height="40" Background="#2b2b2b" Orientation="Horizontal" Spacing="10">
      <Button Content="Settings" Margin="10,0,0,0" Click="OnSettingsClick" />
      <Button Content="Alert Actions" Click="OnAlertActionsClick" />
      <Button Content="Test Alert" Click="OnTestAlertClick" />
      <TextBlock Text="{Binding GpuName}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="20,0,0,0"/>
      <TextBlock Text="{Binding PowerLimit, StringFormat='(TDP: {0:F0}W)'}" VerticalAlignment="Center" Foreground="#888" Margin="10,0,0,0"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Height="30" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="System Ready" Margin="10,0" VerticalAlignment="Center" Foreground="#aaa" FontSize="12"/>
        <TextBlock Grid.Column="1" Text="v1.1.0" Margin="10,0" VerticalAlignment="Center" Foreground="#555" FontSize="12"/>
      </Grid>
    </Border>

    <Grid RowDefinitions="*, *, *">

      <!-- Primary Metric Chart (GPU/CPU Utilization) -->
      <Border Grid.Row="0" Margin="5" Background="#1a1a1a" CornerRadius="5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="{Binding PrimaryMetricLabel}" Foreground="LimeGreen" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentUtilization, StringFormat=': {0:F0} %'}"
                       Foreground="LimeGreen"
                       FontSize="14"
                       Margin="5,0"/>
          </StackPanel>
          <lvc:CartesianChart Series="{Binding UtilizationSeries}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding UtilizationYAxes}" />
        </DockPanel>
      </Border>

      <!-- Temperature Chart (GPU/CPU Temperature) -->
      <Border Grid.Row="1" Margin="5" Background="#1a1a1a" CornerRadius="5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="{Binding TemperatureLabel}" Foreground="OrangeRed" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentTemperature, StringFormat=': {0:F1} °C'}"
                       Foreground="{Binding IsTempAlert, Converter={StaticResource AlertColorConverter}}"
                       FontSize="14" Margin="5,0"/>
          </StackPanel>
          <lvc:CartesianChart Series="{Binding TempSeries}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding TempYAxes}" />
        </DockPanel>
      </Border>

      <!-- Secondary Metric Chart (Power Usage / Network I/O) -->
      <Border Grid.Row="2" Margin="5" Background="#1a1a1a" CornerRadius="5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="{Binding SecondaryMetricLabel}" Foreground="Cyan" FontSize="14" FontWeight="Bold"/>
            <TextBlock Foreground="Cyan" FontSize="14" Margin="5,0">
              <TextBlock.Text>
                <MultiBinding StringFormat=": {0:F1} {1}">
                  <Binding Path="CurrentPower"/>
                  <Binding Path="SecondaryMetricUnit"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <lvc:CartesianChart Series="{Binding PowerSeries}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding PowerYAxes}" />
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>
</UserControl>
