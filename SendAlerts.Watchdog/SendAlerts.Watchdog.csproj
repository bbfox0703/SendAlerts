<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SendAlerts.Watchdog</RootNamespace>
    <AssemblyName>SendAlerts.Watchdog</AssemblyName>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- IL2104: 第三方套件 (Avalonia, ScottPlot) 的 trim 警告，TrimMode=partial 不會 trim 這些 assembly，安全 suppress -->
    <!-- TrimMode=partial + JsonSerializerIsReflectionEnabledByDefault=true 下，以下 trim 警告安全 suppress:
         IL2026/IL2075: 自身程式碼的 reflection/JSON 序列化 (partial trim 不會 trim 自身 assembly)
         IL2104: 第三方套件 (Avalonia, ScottPlot) 的 trim 警告 -->
    <NoWarn>$(NoWarn);IL2026;IL2075;IL2104</NoWarn>
    <!-- Output to same folder as Desktop -->
    <OutDir>..\SendAlerts.Desktop\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>SendAlerts.Watchdog.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SendAlerts.Watchdog.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="SendAlerts.Watchdog.ico" LogicalName="SendAlerts.Watchdog.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SendAlerts\SendAlerts.csproj" />
  </ItemGroup>
</Project>
