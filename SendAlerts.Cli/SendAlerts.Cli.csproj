<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SendAlerts.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SendAlerts-cli</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- 與 Desktop 共用輸出資料夾 -->
    <OutputPath>..\SendAlerts.Desktop\bin\$(Configuration)\$(TargetFramework)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>SendAlerts-CLI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SendAlerts-CLI.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SendAlerts\SendAlerts.csproj" />
  </ItemGroup>

</Project>
