<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SendAlerts.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="550"
        x:Class="SendAlerts.Views.EditActionDialog"
        x:DataType="vm:EditActionViewModel"
        Title="{Binding Title}"
        Width="500" Height="550"
        MinWidth="450" MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:EditActionViewModel />
    </Design.DataContext>

    <Border Padding="16">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- Action Type Selection -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Action Type" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ActionTypes}"
                              SelectedItem="{Binding SelectedActionType}"
                              IsEnabled="{Binding CanChangeType}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Settings Panel -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12">

                    <!-- Common Settings -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Common Settings" FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Instance ID:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InstanceId}" Watermark="Unique identifier"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cooldown:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <NumericUpDown Value="{Binding CooldownSeconds}"
                                                   Minimum="5" Maximum="300"
                                                   Increment="5"
                                                   FormatString="0"
                                                   Width="100"/>
                                    <TextBlock Text="seconds" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>

                                <CheckBox Grid.Row="2" Grid.Column="1" Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,8,0,0"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" Content="Debug Mode (log only)" IsChecked="{Binding DebugMode}" Margin="0,4,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CommandLine Settings -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8" Padding="16"
                            IsVisible="{Binding SelectedActionType.Type, Converter={x:Static vm:ActionTypeVisibilityConverter.CommandLine}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Command Line Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="Command to execute:"/>
                            <TextBox Text="{Binding Command}"
                                     Watermark="e.g., powershell -c &quot;...&quot;"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"/>
                            <TextBlock Text="Variables: {power}, {temperature}, {gpu_name}, {alert_type}, {timestamp}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Telegram Settings -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8" Padding="16"
                            IsVisible="{Binding SelectedActionType.Type, Converter={x:Static vm:ActionTypeVisibilityConverter.Telegram}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Telegram Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="Bot Token:"/>
                            <TextBox Text="{Binding TelegramBotToken}"
                                     Watermark="123456789:ABC..."
                                     PasswordChar="*"/>
                            <TextBlock Text="Chat ID:"/>
                            <TextBox Text="{Binding TelegramChatId}"
                                     Watermark="-123456789"/>
                            <TextBlock Text="Get token from @BotFather, Chat ID from /getUpdates API"
                                       FontSize="10"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Discord Settings -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8" Padding="16"
                            IsVisible="{Binding SelectedActionType.Type, Converter={x:Static vm:ActionTypeVisibilityConverter.Discord}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Discord Webhook Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="Webhook URL:"/>
                            <TextBox Text="{Binding DiscordWebhookUrl}"
                                     Watermark="https://discord.com/api/webhooks/..."
                                     PasswordChar="*"/>
                            <TextBlock Text="Username (optional):"/>
                            <TextBox Text="{Binding DiscordUsername}"
                                     Watermark="SendAlerts"/>
                            <TextBlock Text="Get webhook URL from Server Settings → Integrations → Webhooks"
                                       FontSize="10"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- HTTP Webhook Settings (準備中) -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="8" Padding="16"
                            IsVisible="{Binding SelectedActionType.Type, Converter={x:Static vm:ActionTypeVisibilityConverter.HttpWebhook}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="HTTP Webhook Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="URL:"/>
                            <TextBox Text="{Binding WebhookUrl}"
                                     Watermark="https://example.com/webhook"/>
                            <TextBlock Text="HTTP Method:"/>
                            <ComboBox SelectedItem="{Binding WebhookHttpMethod}" Width="120">
                                <ComboBoxItem Content="GET"/>
                                <ComboBoxItem Content="POST"/>
                                <ComboBoxItem Content="PUT"/>
                            </ComboBox>
                            <TextBlock Text="Body Template (POST/PUT):"/>
                            <TextBox Text="{Binding WebhookBodyTemplate}"
                                     Watermark="JSON body template"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Error Message -->
            <Border Grid.Row="2"
                    Background="#C62828"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="White"
                           FontSize="12"/>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Content="OK"
                        Command="{Binding ConfirmCommand}"
                        Width="80"
                        Classes="accent"/>
            </Grid>

        </Grid>
    </Border>
</Window>
