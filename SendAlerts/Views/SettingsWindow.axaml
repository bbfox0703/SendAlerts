<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SendAlerts.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="600"
        x:Class="SendAlerts.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="550" Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Border Padding="16">
        <Grid RowDefinitions="*,Auto">

            <!-- TabControl for Settings Categories -->
            <TabControl Grid.Row="0">

                <!-- Tab 1: Monitoring Settings -->
                <TabItem Header="Monitoring">
                    <ScrollViewer Margin="0,8,0,0">
                        <StackPanel Spacing="12">

                            <!-- Voltage Threshold -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Voltage Threshold" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,80">
                                        <Slider Grid.Column="0"
                                                Minimum="10" Maximum="13"
                                                Value="{Binding VoltageThreshold}"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VoltageThreshold, StringFormat={}{0:F1} V}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Alert when voltage drops below this value"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Temperature Threshold -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Temperature Threshold" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,80">
                                        <Slider Grid.Column="0"
                                                Minimum="50" Maximum="100"
                                                Value="{Binding TemperatureThreshold}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TemperatureThreshold, StringFormat={}{0:F0} C}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                    <TextBlock Text="Alert when temperature exceeds this value"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Alert Window -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Alert Trigger Condition" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Window (sec)"/>
                                            <NumericUpDown Value="{Binding AlertWindowSeconds}"
                                                           Minimum="1" Maximum="30"
                                                           Increment="1"
                                                           FormatString="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                            <TextBlock Text="Trigger Count"/>
                                            <NumericUpDown Value="{Binding AlertTriggerCount}"
                                                           Minimum="1" Maximum="30"
                                                           Increment="1"
                                                           FormatString="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding AlertWindowSeconds, StringFormat=Trigger when threshold exceeded within {0} seconds}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Sampling Interval -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Sampling Interval" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,80">
                                        <Slider Grid.Column="0"
                                                Minimum="1" Maximum="10"
                                                Value="{Binding SamplingIntervalSeconds}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SamplingIntervalSeconds, StringFormat={}{0} sec}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Alert Actions -->
                <TabItem Header="Alert Actions">
                    <ScrollViewer Margin="0,8,0,0">
                        <StackPanel Spacing="12">

                            <!-- Debug Mode -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Debug Mode (log only, don't execute)"
                                              IsChecked="{Binding AlertActionsDebugMode}"/>
                                    <TextBlock Text="When enabled, alert actions are logged but not executed"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- CommandLine Alert -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Command Line"
                                              IsChecked="{Binding CommandLineAlertEnabled}"
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="Command to execute:"
                                               IsEnabled="{Binding CommandLineAlertEnabled}"/>
                                    <TextBox Text="{Binding CommandLineAlertCommand}"
                                             Watermark="e.g., powershell -c &quot;...&quot;"
                                             IsEnabled="{Binding CommandLineAlertEnabled}"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="Cooldown:"
                                                   VerticalAlignment="Center"
                                                   IsEnabled="{Binding CommandLineAlertEnabled}"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding CommandLineAlertCooldownSeconds}"
                                                       Minimum="5" Maximum="300"
                                                       Increment="5"
                                                       FormatString="0"
                                                       Width="100"
                                                       Margin="8,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       IsEnabled="{Binding CommandLineAlertEnabled}"/>
                                    </Grid>
                                    <TextBlock Text="Variables: {voltage}, {temperature}, {gpu_name}, {alert_type}, {timestamp}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Telegram Alert -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Telegram"
                                              IsChecked="{Binding TelegramAlertEnabled}"
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="Bot Token:"
                                               IsEnabled="{Binding TelegramAlertEnabled}"/>
                                    <TextBox Text="{Binding TelegramBotToken}"
                                             Watermark="123456789:ABC..."
                                             PasswordChar="*"
                                             IsEnabled="{Binding TelegramAlertEnabled}"/>
                                    <TextBlock Text="Chat ID:"
                                               IsEnabled="{Binding TelegramAlertEnabled}"/>
                                    <TextBox Text="{Binding TelegramChatId}"
                                             Watermark="-123456789"
                                             IsEnabled="{Binding TelegramAlertEnabled}"/>
                                    <TextBlock Text="Get token from @BotFather, Chat ID from /getUpdates API"
                                               FontSize="10"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- LINE Notify has been discontinued - Use Alert Center for Discord -->
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="8" Padding="16"
                                    Opacity="0.6">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LINE Notify (Discontinued)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="LINE Notify has been discontinued by LINE. Please use Alert Center with Discord Webhook instead."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Column="0"
                        Content="Reset Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        HorizontalContentAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="80"
                        HorizontalContentAlignment="Center"
                        Classes="accent"/>
            </Grid>

        </Grid>
    </Border>
</Window>
