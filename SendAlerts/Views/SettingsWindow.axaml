<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SendAlerts.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="280"
        x:Class="SendAlerts.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="400" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Border Padding="16">
        <Grid RowDefinitions="*,Auto">

            <StackPanel Grid.Row="0" Spacing="12">

                <!-- Sampling Interval -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sampling Interval" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,80">
                            <Slider Grid.Column="0"
                                    Minimum="1" Maximum="10"
                                    Value="{Binding SamplingIntervalSeconds}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SamplingIntervalSeconds, StringFormat={}{0} sec}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="How often to read hardware data for display"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Alert Center Info -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Alert Center" FontWeight="SemiBold"/>
                        <TextBlock Text="To configure alert actions and groups, use the buttons on the main screen:"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="#2E7D32" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="Alert Actions" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Background="#1565C0" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="Alert Groups" Foreground="White" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="80"
                        HorizontalContentAlignment="Center"
                        Classes="accent"/>
            </Grid>

        </Grid>
    </Border>
</Window>
