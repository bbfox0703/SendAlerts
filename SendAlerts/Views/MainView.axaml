<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SendAlerts.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:conv="clr-namespace:SendAlerts.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="SendAlerts.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Resources>
	  <conv:AlertColorConverter x:Key="AlertColorConverter" />
	  <conv:StatusColorConverter x:Key="StatusColorConverter" />
  </UserControl.Resources>

  <DockPanel>
    <!-- Navigation bar -->
    <StackPanel DockPanel.Dock="Top" Height="40" Background="#2b2b2b" Orientation="Horizontal" Spacing="10">
      <Button Content="{Binding Loc_Settings}" Margin="10,0,0,0" Click="OnSettingsClick" />
      <Button Content="{Binding Loc_AlertActions}" Click="OnAlertActionsClick" />
      <Button Content="{Binding Loc_AlertGroups}" Click="OnAlertGroupsClick" />
      <Button Content="{Binding Loc_Log}" Click="OnLogClick" />
      <Button Content="Diag" Click="OnDiagnosticsClick" />
      <TextBlock Text="{Binding GpuName}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="10,0,0,0"/>
      <TextBlock Text="{Binding PowerLimitDisplay}" VerticalAlignment="Center" Foreground="#888" Margin="10,0,0,0"/>
      <!-- Display mode hint -->
      <Border Background="#3a3a00" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Loc_DisplayModeHint}" Foreground="#ffcc00" FontSize="11"/>
      </Border>
    </StackPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Height="30" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="10,0,5,0"
                 Fill="{Binding IsPipeServerRunning, Converter={StaticResource StatusColorConverter}}"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#aaa" FontSize="12"/>
        <TextBlock Grid.Column="2" Text="{Binding AvgSummary}" VerticalAlignment="Center" Foreground="#888" FontSize="11" Margin="10,0"/>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#666" FontSize="12" Margin="10,0">
          <TextBlock.Text>
            <MultiBinding StringFormat="Alerts: {0}">
              <Binding Path="AlertHistoryItems.Count"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Grid.Column="4" Text="{Binding VersionDisplay}" Margin="10,0" VerticalAlignment="Center" Foreground="#555" FontSize="12"/>
      </Grid>
    </Border>

    <Grid RowDefinitions="*, *, *, *, Auto">

      <!-- Chart Slot 0 -->
      <Border Grid.Row="0" Margin="5" Background="#1a1a1a" CornerRadius="5"
              IsVisible="{Binding Slot0IsVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <Button Content="&#x2699;" Command="{Binding OpenSlotConfigCommand}" CommandParameter="0"
                    FontSize="11" Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Slot0Label}" Foreground="{Binding Slot0Color}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Foreground="{Binding Slot0Color}" FontSize="14" Margin="5,0">
              <TextBlock.Text>
                <MultiBinding StringFormat=": {0} {1}">
                  <Binding Path="Slot0ValueDisplay"/>
                  <Binding Path="Slot0Unit"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <sp:AvaPlot x:Name="Chart0" />
        </DockPanel>
      </Border>

      <!-- Chart Slot 1 -->
      <Border Grid.Row="1" Margin="5" Background="#1a1a1a" CornerRadius="5"
              IsVisible="{Binding Slot1IsVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <Button Content="&#x2699;" Command="{Binding OpenSlotConfigCommand}" CommandParameter="1"
                    FontSize="11" Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Slot1Label}" Foreground="{Binding Slot1Color}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Foreground="{Binding Slot1Color}" FontSize="14" Margin="5,0">
              <TextBlock.Text>
                <MultiBinding StringFormat=": {0} {1}">
                  <Binding Path="Slot1ValueDisplay"/>
                  <Binding Path="Slot1Unit"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <sp:AvaPlot x:Name="Chart1" />
        </DockPanel>
      </Border>

      <!-- Chart Slot 2 -->
      <Border Grid.Row="2" Margin="5" Background="#1a1a1a" CornerRadius="5"
              IsVisible="{Binding Slot2IsVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <Button Content="&#x2699;" Command="{Binding OpenSlotConfigCommand}" CommandParameter="2"
                    FontSize="11" Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Slot2Label}" Foreground="{Binding Slot2Color}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Foreground="{Binding Slot2Color}" FontSize="14" Margin="5,0">
              <TextBlock.Text>
                <MultiBinding StringFormat=": {0} {1}">
                  <Binding Path="Slot2ValueDisplay"/>
                  <Binding Path="Slot2Unit"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <sp:AvaPlot x:Name="Chart2" />
        </DockPanel>
      </Border>

      <!-- Chart Slot 3 -->
      <Border Grid.Row="3" Margin="5" Background="#1a1a1a" CornerRadius="5"
              IsVisible="{Binding Slot3IsVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,5">
            <Button Content="&#x2699;" Command="{Binding OpenSlotConfigCommand}" CommandParameter="3"
                    FontSize="11" Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Slot3Label}" Foreground="{Binding Slot3Color}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Foreground="{Binding Slot3Color}" FontSize="14" Margin="5,0">
              <TextBlock.Text>
                <MultiBinding StringFormat=": {0} {1}">
                  <Binding Path="Slot3ValueDisplay"/>
                  <Binding Path="Slot3Unit"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <sp:AvaPlot x:Name="Chart3" />
        </DockPanel>
      </Border>

      <!-- Alert History Panel -->
      <Border Grid.Row="4" Margin="5,0,5,5" Background="#1a1a1a" CornerRadius="5"
              IsVisible="{Binding AlertHistoryItems.Count, Converter={x:Static conv:GreaterThanZeroConverter.Instance}}">
        <Expander Header="{Binding Loc_RecentAlerts}" IsExpanded="False" Padding="5">
          <ItemsControl ItemsSource="{Binding AlertHistoryItems}" MaxHeight="120">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                  <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0"
                           Fill="{Binding Success, Converter={StaticResource StatusColorConverter}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding TimeString}" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="#ccc" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </Border>

    </Grid>
  </DockPanel>
</UserControl>
