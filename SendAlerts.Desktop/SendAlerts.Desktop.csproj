<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SendAlerts.Desktop</RootNamespace>
    <AssemblyName>SendAlerts.Desktop</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Publish: Self-Contained，使用者不需安裝 .NET Runtime -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- .NET 10 預設停用 reflection-based JSON；本專案廣泛使用 JsonSerializer，重新啟用 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SendAlerts.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SendAlerts.ico" />
  </ItemGroup>

  <!-- Silent VBS wrapper for HWiNFO integration -->
  <ItemGroup>
    <None Include="..\scripts\SendAlerts-cli-silent.vbs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="SendAlerts-cli-silent.vbs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Angle.Windows.Natives" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BlackSharp.Core" />
    <PackageReference Include="DiskInfoToolkit" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="runtime.native.System.IO.Ports" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SendAlerts\SendAlerts.csproj" />
  </ItemGroup>
</Project>
